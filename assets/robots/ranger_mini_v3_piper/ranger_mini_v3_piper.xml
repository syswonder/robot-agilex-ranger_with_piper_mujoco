<mujoco model="ranger_mini_v3_piper">
  <compiler angle="radian" meshdir="meshes"/>
  <option timestep="0.002" cone="elliptic" integrator="implicitfast"/>

  <default>
    <joint armature="0.01" damping="0.2"/>
    <default class="steering">
      <joint axis="0 0 1" limited="true" range="-2.1 2.1" damping="1.5"/>
      <position kp="80" kv="8" ctrlrange="-2.1 2.1" forcerange="-35 35"/>
    </default>
    <default class="wheel">
      <joint axis="0 1 0" damping="0.05"/>
      <velocity kv="8" ctrlrange="-12 12" forcerange="-30 30"/>
    </default>
    <default class="wheel_collision">
      <geom type="cylinder" size="0.09 0.04" quat="0.7071068 0.7071068 0 0"
            condim="4" friction="1.2 0.01 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    </default>
  </default>

  <asset>
    <!-- MuJoCo Menagerie AgileX PiPER, pinned in piper/ with its MIT license. -->
    <model name="piper_model" file="piper/piper.xml"/>
    <material name="chassis_material" rgba="0.18 0.24 0.32 1" metallic="0.15" roughness="0.42"/>
    <material name="steering_material" rgba="0.34 0.39 0.47 1" metallic="0.1" roughness="0.5"/>
    <material name="tire_material" rgba="0.035 0.04 0.045 1" roughness="0.85"/>
    <material name="rack_aluminum" rgba="0.72 0.75 0.76 1" metallic="0.65" roughness="0.28"/>
    <material name="rack_panel" rgba="0.62 0.65 0.64 1" metallic="0.35" roughness="0.38"/>
    <material name="equipment_black" rgba="0.045 0.055 0.06 1" metallic="0.15" roughness="0.62"/>
    <material name="equipment_green" rgba="0.25 0.28 0.22 1" metallic="0.05" roughness="0.72"/>
    <material name="sensor_lens" rgba="0.04 0.16 0.24 0.82" metallic="0.15" roughness="0.18"/>
    <mesh name="ranger_base" file="ranger_base.stl" scale="1000 1000 1000"/>
    <mesh name="steering_wheel" file="steering_wheel.stl" scale="10 10 10"/>
    <mesh name="wheel_v3" file="wheel_v3.stl" scale="10 10 10"/>
  </asset>

  <worldbody>
    <body name="ranger_base_link" pos="0 0 0.31">
      <freejoint name="ranger_base_freejoint"/>
      <inertial pos="-0.0243 -0.0030 -0.1056" mass="18"
                diaginertia="0.31 0.48 0.62"/>
      <geom name="ranger_base_visual" type="mesh" mesh="ranger_base"
            material="chassis_material" contype="0" conaffinity="0" density="0" group="1"/>
      <geom name="ranger_base_collision" type="box" pos="-0.015 0 -0.105" size="0.31 0.18 0.09"
            rgba="0 0 0 0" mass="0" friction="0.8 0.02 0.002" group="4"/>

      <!-- +X is Ranger forward; Piper follows the rear-center deployment layout. -->
      <body name="piper_mount" pos="-0.20 0 0.025" quat="0 0 0 1">
        <inertial pos="0 0 -0.006" mass="0.45" diaginertia="0.0012 0.0014 0.0018"/>
        <geom name="piper_mount_plate" type="box" pos="0 0 -0.006" size="0.085 0.075 0.006"
              material="steering_material" contype="0" conaffinity="0" density="0" group="1"/>
        <site name="piper_mount_frame" type="sphere" size="0.006" rgba="0.9 0.2 0.1 0.4"/>
        <attach model="piper_model" body="base_link" prefix="piper_"/>
      </body>

      <!--
        Front sensor rack reconstructed from the Robonix Ranger photograph.
        Sensor frame coordinates match its deployment URDF placeholders:
        MID-360 at [0.18, 0, 0.425], Gemini at [0.28, 0, 0.30].
      -->
      <body name="sensor_rack" pos="0.18 0 0.025">
        <inertial pos="0 0 0.18" mass="7" diaginertia="0.12 0.10 0.08"/>

        <!-- Four 25 mm aluminum-extrusion posts and top/bottom frame. -->
        <geom type="box" pos="-0.12 -0.15 0.18" size="0.0125 0.0125 0.18"
              material="rack_aluminum" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="-0.12 0.15 0.18" size="0.0125 0.0125 0.18"
              material="rack_aluminum" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="0.12 -0.15 0.18" size="0.0125 0.0125 0.18"
              material="rack_aluminum" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="0.12 0.15 0.18" size="0.0125 0.0125 0.18"
              material="rack_aluminum" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="0 -0.15 0.35" size="0.145 0.0125 0.0125"
              material="rack_aluminum" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="0 0.15 0.35" size="0.145 0.0125 0.0125"
              material="rack_aluminum" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="-0.12 0 0.35" size="0.0125 0.175 0.0125"
              material="rack_aluminum" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="0.12 0 0.35" size="0.0125 0.175 0.0125"
              material="rack_aluminum" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="0 0 0.365" size="0.145 0.175 0.005"
              material="rack_panel" contype="0" conaffinity="0" density="0" group="1"/>

        <!-- Compute/power payload visible inside the open rack. -->
        <geom type="box" pos="-0.015 0 0.09" size="0.095 0.125 0.065"
              material="equipment_green" contype="0" conaffinity="0" density="0" group="1"/>
        <geom type="box" pos="-0.055 0 0.205" size="0.07 0.105 0.032"
              material="equipment_black" contype="0" conaffinity="0" density="0" group="1"/>
        <geom name="sensor_rack_collision" type="box" pos="0 0 0.19" size="0.15 0.18 0.19"
              rgba="0 0 0 0" mass="0" friction="0.8 0.02 0.002" group="4"/>

        <!-- Livox MID-360, including its co-located ICM40609 IMU frame. -->
        <body name="mid360_link" pos="0 0 0.40">
          <geom type="box" pos="0 0 -0.012" size="0.0325 0.0325 0.018"
                material="equipment_black" contype="0" conaffinity="0" density="0" group="1"/>
          <geom type="cylinder" pos="0 0 0.012" size="0.030 0.015"
                material="equipment_black" contype="0" conaffinity="0" density="0" group="1"/>
          <geom type="sphere" pos="0 0 0.025" size="0.026"
                material="sensor_lens" contype="0" conaffinity="0" density="0" group="1"/>
          <site name="mid360_lidar_site" type="sphere" size="0.004" rgba="0.1 1 0.4 0.6"/>
          <site name="mid360_imu_site" type="sphere" size="0.003" rgba="1 0.3 0.1 0.6"/>
        </body>

        <!-- Front Orbbec Gemini 336L RGB-D camera, facing Ranger +X. -->
        <body name="front_rgbd_link" pos="0.10 0 0.275">
          <geom type="box" size="0.018 0.060 0.022" material="equipment_black"
                contype="0" conaffinity="0" density="0" group="1"/>
          <geom type="cylinder" pos="0.021 -0.030 0" quat="0.707107 0 0.707107 0" size="0.009 0.003"
                material="sensor_lens" contype="0" conaffinity="0" density="0" group="1"/>
          <geom type="cylinder" pos="0.021 0.030 0" quat="0.707107 0 0.707107 0" size="0.009 0.003"
                material="sensor_lens" contype="0" conaffinity="0" density="0" group="1"/>
          <site name="front_rgbd_site" pos="0.022 0 0" xyaxes="0 -1 0 0 0 1"
                type="sphere" size="0.003" rgba="0.1 0.7 1 0.6"/>
          <camera name="front_rgbd_camera" mode="fixed" pos="0.022 0 0"
                  xyaxes="0 -1 0 0 0 1" fovy="65"/>
        </body>
      </body>

      <body name="fl_steering_wheel_link" pos="0.25 0.19 -0.1">
        <inertial pos="0 0 0.0436" mass="1" diaginertia="0.0064 0.0064 0.0105"/>
        <joint name="fl_steering_joint" class="steering"/>
        <geom type="mesh" mesh="steering_wheel" quat="0 0 0 1" material="steering_material"
              contype="0" conaffinity="0" density="0" group="1"/>
        <body name="fl_wheel_link" pos="0 0 -0.12">
          <inertial pos="0 0 0" mass="2" diaginertia="0.008 0.012 0.008"/>
          <joint name="fl_wheel_joint" class="wheel"/>
          <geom type="mesh" mesh="wheel_v3" material="tire_material"
                contype="0" conaffinity="0" density="0" group="1"/>
          <geom name="fl_wheel_collision" class="wheel_collision" mass="0" rgba="0 0 0 0" group="4"/>
        </body>
      </body>

      <body name="fr_steering_wheel_link" pos="0.25 -0.19 -0.1">
        <inertial pos="0 0 0.0436" mass="1" diaginertia="0.0064 0.0064 0.0105"/>
        <joint name="fr_steering_joint" class="steering"/>
        <geom type="mesh" mesh="steering_wheel" material="steering_material"
              contype="0" conaffinity="0" density="0" group="1"/>
        <body name="fr_wheel_link" pos="0 0 -0.12">
          <inertial pos="0 0 0" mass="2" diaginertia="0.008 0.012 0.008"/>
          <joint name="fr_wheel_joint" class="wheel"/>
          <geom type="mesh" mesh="wheel_v3" quat="0 1 0 0" material="tire_material"
                contype="0" conaffinity="0" density="0" group="1"/>
          <geom name="fr_wheel_collision" class="wheel_collision" mass="0" rgba="0 0 0 0" group="4"/>
        </body>
      </body>

      <body name="rl_steering_wheel_link" pos="-0.25 0.19 -0.1">
        <inertial pos="0 0 0.0436" mass="1" diaginertia="0.0064 0.0064 0.0105"/>
        <joint name="rl_steering_joint" class="steering"/>
        <geom type="mesh" mesh="steering_wheel" quat="0 0 0 1" material="steering_material"
              contype="0" conaffinity="0" density="0" group="1"/>
        <body name="rl_wheel_link" pos="0 0 -0.12">
          <inertial pos="0 0 0" mass="2" diaginertia="0.008 0.012 0.008"/>
          <joint name="rl_wheel_joint" class="wheel"/>
          <geom type="mesh" mesh="wheel_v3" material="tire_material"
                contype="0" conaffinity="0" density="0" group="1"/>
          <geom name="rl_wheel_collision" class="wheel_collision" mass="0" rgba="0 0 0 0" group="4"/>
        </body>
      </body>

      <body name="rr_steering_wheel_link" pos="-0.25 -0.19 -0.1">
        <inertial pos="0 0 0.0436" mass="1" diaginertia="0.0064 0.0064 0.0105"/>
        <joint name="rr_steering_joint" class="steering"/>
        <geom type="mesh" mesh="steering_wheel" material="steering_material"
              contype="0" conaffinity="0" density="0" group="1"/>
        <body name="rr_wheel_link" pos="0 0 -0.12">
          <inertial pos="0 0 0" mass="2" diaginertia="0.008 0.012 0.008"/>
          <joint name="rr_wheel_joint" class="wheel"/>
          <geom type="mesh" mesh="wheel_v3" quat="0 1 0 0" material="tire_material"
                contype="0" conaffinity="0" density="0" group="1"/>
          <geom name="rr_wheel_collision" class="wheel_collision" mass="0" rgba="0 0 0 0" group="4"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="fl_wheel_motor" joint="fl_wheel_joint" class="wheel"/>
    <velocity name="fr_wheel_motor" joint="fr_wheel_joint" class="wheel"/>
    <velocity name="rl_wheel_motor" joint="rl_wheel_joint" class="wheel"/>
    <velocity name="rr_wheel_motor" joint="rr_wheel_joint" class="wheel"/>
    <position name="fl_steering" joint="fl_steering_joint" class="steering"/>
    <position name="fr_steering" joint="fr_steering_joint" class="steering"/>
    <position name="rl_steering" joint="rl_steering_joint" class="steering"/>
    <position name="rr_steering" joint="rr_steering_joint" class="steering"/>
  </actuator>

  <contact>
    <exclude body1="ranger_base_link" body2="piper_base_link"/>
    <exclude body1="ranger_base_link" body2="fl_wheel_link"/>
    <exclude body1="ranger_base_link" body2="fr_wheel_link"/>
    <exclude body1="ranger_base_link" body2="rl_wheel_link"/>
    <exclude body1="ranger_base_link" body2="rr_wheel_link"/>
  </contact>

  <sensor>
    <gyro name="mid360_gyro" site="mid360_imu_site" noise="0.001" cutoff="100"/>
    <accelerometer name="mid360_accelerometer" site="mid360_imu_site" noise="0.02" cutoff="100"/>
    <framepos name="mid360_position" objtype="site" objname="mid360_lidar_site"/>
    <framequat name="mid360_orientation" objtype="site" objname="mid360_lidar_site"/>
  </sensor>
</mujoco>
