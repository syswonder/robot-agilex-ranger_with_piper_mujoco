# Robonix is normally discovered with `rbnx path robonix-api`. Set one of these
# only when automatic discovery is unavailable.
# ROBONIX_SOURCE_PATH=/absolute/path/to/robonix
# ROBONIX_API_PATH=/absolute/path/to/robonix/pylib/robonix-api

# Required by Pilot and the pick skill. Keep this secret out of Git.
# VLM_BASE_URL=https://api.openai.com/v1
# VLM_API_KEY=replace-me
# VLM_MODEL=gpt-5.6-sol

# ROBONIX_SIM_CONTAINER=mujoco_robonix_sim
# MUJOCO_RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Default simulator backend. Valid values: web, native.
# SIM_BACKEND=web
# Set 1 on a machine with no display: the native viewer does not open, and the
# web backend renders in a headless browser instead of a window.
# SIM_HEADLESS=0
# Web backend, headless only. 1 renders on the GPU through ANGLE/EGL; 0 falls
# back to software WebGL, which is far slower. Ignored when SIM_HEADLESS=0.
# SIM_GPU_HEADLESS=1
# Native mode rejects software OpenGL unless explicitly disabled.
# SIM_GPU_REQUIRED=1
